# Backend
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./chatgpt_platform.db
# DATABASE_URL=postgresql://user:password@host:5432/chatgpt_platform

# JWT Security - CHANGE THIS IN PRODUCTION
JWT_SECRET_KEY=chatgpt-platform-super-secret-key-change-in-production-2026

# Google OAuth (Optional - needed for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Optional - for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your@gmail.com

# App Config
APP_NAME=ChatGPT Platform
FRONTEND_URL=http://localhost:3000
HOST=0.0.0.0
PORT=8000
